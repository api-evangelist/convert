              "body": "{\n  \"data\": [\n    {\n      \"name\": \"string\",\n      \"auth_type\": \"secretKey\",\n      \"projects\": [\n        6514.852319564413,\n        2201.0199452097722\n      ],\n      \"key_id\": \"string\",\n      \"key_secret\": \"string\",\n      \"role\": \"browse\"\n    },\n    {\n      \"name\": \"string\",\n      \"auth_type\": \"secretKey\",\n      \"projects\": [\n        3268.220103260263,\n        2481.6428412771374\n      ],\n      \"key_id\": \"string\",\n      \"key_secret\": \"string\",\n      \"role\": \"browse\"\n    }\n  ]\n}",

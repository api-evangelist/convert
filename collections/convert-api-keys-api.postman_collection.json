      },
      "item": [
        {
          "id": "4804bfc8-d70f-4422-b6bd-93a88ccb3b37",
          "name": "List API keys for an account",
          "request": {
            "name": "List API keys for an account",
            "description": {
              "content": "Retrieves a list of all API keys configured for the specified account.\nAPI keys are used for server-to-server authentication, allowing applications to interact with the Convert API programmatically.\nEach key can be scoped to specific projects.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":account_id",
                "api-keys"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "account_id",
                  "description": "(Required) ID of the account that owns the retrieved/saved data"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "339d1fd5-6400-4fc5-b05d-978f6ac6ba7d",
              "name": "A list of API keys configured for the account. Each entry includes the key's name, its ID (part of the key itself), and the projects it's scoped to. The secret is masked for existing keys.",
              "originalRequest": {
                "url": {
                  "path": [
                    "accounts",
                    ":account_id",
                    "api-keys"
                  ],
                  "host": [

        {
          "id": "0133889d-13f9-4291-9394-cd1cb480f4ca",
          "name": "List Convert Signals™ (visitor frustration sessions)",
          "request": {
            "name": "List Convert Signals™ (visitor frustration sessions)",
            "description": {
              "content": "Retrieves a list of Convert Signals™ sessions for a project.\nConvert Signals™ \"is a special anonymous and privacy oriented session recording feature...It shows only really clear frustrations, errors and usability signals of real users\".\nUse this to identify sessions where visitors experienced issues like rage clicks, dead clicks, or scroll stalls.\nSupports filtering by date, experience, variation, location, country, device, browser, and more.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":account_id",
                "projects",
                ":project_id",
                "signal_sessions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "account_id",
                  "description": "(Required) ID of the account that owns the retrieved/saved data"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "project_id",
                  "description": "(Required) ID of the project to be retrieved"
                }
              ]
            },

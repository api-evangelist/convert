          "id": "269edd7f-d28a-4dcd-9288-8f015915bf5f",
          "name": "Generate text variations using AI",
          "request": {
            "name": "Generate text variations using AI",
            "description": {
              "content": "Leverages Generative AI to create alternative text versions (variants) for a given piece of content.\nUsers can specify the number of variations, the original content, an AI model framework (e.g., Cialdini, AIDA), and a specific principle within that framework.\nThis helps in quickly generating creative options for A/B testing headlines, calls to action, or other textual elements.\nOptionally, an OpenAI Key can be provided for using more advanced models or larger context.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":account_id",
                "ai",
                "text"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "account_id",
                  "description": "(Required) ID of the account under which the api call executes"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"<string>\",\n  \"parameters\": {\n    \"variationsNumber\": 1\n  },\n  \"openAI_Key\": \"<string>\",\n  \"context_content\": \"<string>\",\n  \"previousResponses\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"principle_class\": \"<string>\"\n}",
              "options": {

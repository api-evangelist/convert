          "id": "0e55df39-977f-4769-abf5-a5c166baa157",
          "name": "List SDK keys for a project",
          "request": {
            "name": "List SDK keys for a project",
            "description": {
              "content": "Retrieves a list of SDK keys associated with a specific project.\nSDK keys are used by Convert's Full Stack SDKs (e.g., Node.js, JavaScript) to fetch experiment configurations and track events from server-side or client-side applications.\nEach key is tied to a specific environment within the project (e.g., production, staging).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":account_id",
                "projects",
                ":project_id",
                "sdk-keys"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "account_id",
                  "description": "(Required) ID of the account that owns the retrieved/saved data"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "project_id",
                  "description": "(Required) ID of the project to be retrieved"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "65e01f9e-5c52-41ca-8e74-eeb09cbd4b67",
              "name": "A list of SDK keys defined for a project. Each key is associated with an environment (e.g., production, staging) and is used by Convert's Full Stack SDKs for authentication and configuration fetching.",
